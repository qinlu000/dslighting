  "structure": [
    {"description":"tcga_expression and tcga_labels align rowwise by their unnamed sample-ID column; Class is the cancer-type label for the expression profile.","objects":["tcga_expression","tcga_labels"]},
    {"description":"The TCGA-CDR workbook is multi-sheet and uses patient barcode and cancer type as its main identifiers; paired endpoint event and .time columns must be interpreted together.","objects":["tcga_clinical"]},
    {"description":"Patient.ID joins to Examination.ID and Laboratory.ID; Laboratory has repeated dates per patient, while Patient is one row per ID.","objects":["thrombosis_patient","thrombosis_examination","thrombosis_laboratory"]},
    {"description":"The three thrombosis dictionary CSVs describe the correspondingly named SQLite tables and include value encodings and units where available.","objects":["thrombosis_examination_dictionary","thrombosis_laboratory_dictionary","thrombosis_patient_dictionary","thrombosis_examination","thrombosis_laboratory","thrombosis_patient"]}
  ],
  "uncertainties": [
    "Several clinical files encode missingness with strings such as ?, N/A, NA, [Not Available], blank cells, or irregular whitespace rather than one uniform null marker.",
    "The TCGA workbook contains notes and multi-row headers on some support sheets; reading every sheet with a single default header row can mislabel columns.",
    "Some thrombosis laboratory abbreviations and units are only partially documented; consult the supplied dictionary rows before interpreting magnitudes."
  ],
  "annotation_notes": [
    "The 20,530 regular expression features are grouped because they form a high-dimensional numbered family.",
    "Descriptions were derived from public schemas, workbook labels, ARFF metadata, and the supplied public dictionaries only."
  ]
}
